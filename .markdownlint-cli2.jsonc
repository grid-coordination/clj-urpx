// SPDX-License-Identifier: MIT
//
// markdownlint-cli2 loads this file from the directory it runs in:
//
//   markdownlint-cli2 README.md CHANGELOG.md 'doc/*.md'
//
// Disabled rules:
//
// - MD013 (line-length): each paragraph is written as one line and left to
//   the viewer to soft-wrap.
// - MD025 (single-title): a document may use more than one H1 as a
//   structural divider.
// - MD033 (inline HTML): SPDX headers are HTML comments.
// - MD040 (fenced-code-language): bare fences hold literal output and file
//   dumps, where a language tag would be noise.
// - MD041 (first-line-h1): an SPDX header comment may precede the first H1.
// - MD060 (table-column-style): tables are written compact, without padding.
//
// Customized rules:
//
// - MD024 (no-duplicate-heading): siblings_only, so the same heading text may
//   recur under different parents.
{
  "config": {
    "MD013": false,
    "MD025": false,
    "MD033": false,
    "MD040": false,
    "MD041": false,
    "MD060": false,
    "MD024": { "siblings_only": true }
  }
}
