;;
;; Drift that scripts/shacl-drift.sh should NOT fail on, because it is a
;; deliberate decision rather than something left behind.
;;
;; This is for ACCEPTED drift only. A known bug does not belong here: silencing
;; it here is how it stops being known. File it and leave the detector failing
;; until it is fixed.
;;
;; Each entry is [schema-var property finding-kind]. Say why, every time: an
;; unexplained entry is indistinguishable from one added to make the gate green.

{:accepted
 [;; urpx-org/urpx#80 drops both to sh:minCount 0: a tier hosting adjusting
  ;; brackets carries no serviceTierNumber, and a billing model that only
  ;; moves bounds carries no PriceDefinition. Held optional for the adjusting
  ;; brackets this library resolves; drop these entries once the pinned shapes
  ;; carry that change.
  ["ServiceTier" "urpx:serviceTierNumber" "under-validates"]
  ["BillingModel" "urpx:hasPriceDefinition" "under-validates"]

  ;; urpx-org/urpx#77 adds urpx:mondayIfSundayObservance to
  ;; urpx:ObservanceRuleValue, and this library accepts and applies it. Drop
  ;; this entry once the pinned shapes carry that change.
  ["Holiday" "urpx:observanceRule" "enum-drift"]]}
