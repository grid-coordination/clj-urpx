    "@id": "pge:e-tou-c-baseline-tier",
    "urpx:name": "E-TOU-C Baseline Credit + Conservation Incentive Adjustment",
    "urpx:modifierUniqueIdentifier": "E-TOU-C-BASELINE-TIER",
    "urpx:initialEffectiveDate": "2026-03-01",
