      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sdge:fera-2026-04-01-er-eligible",
          "urpx:name": "FERA-eligible residential customer (Lower-Middle Income tier)",
          "urpx:description": "Customer must be a residential customer enrolled in the FERA program per Schedule FERA Special Condition 1: total annual gross household income between 200% + $1 and 250% of the Federal Poverty Limit (income table size-adjusted by household, 1-2 persons through 8+, updated annually by CPUC). 3+ persons living in the household required. Application + eligibility declaration required (Special Condition 2). Customers may be rebilled for periods of ineligibility (Special Condition 6). NOT applicable to customers receiving CARE or DM service.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sdge:fera-2026-04-01-cx-eligible",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "sdge:fera-2026-04-01-bn-residential-and-enrolled",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
