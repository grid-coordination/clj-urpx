  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sdge:fera",
    "urpx:name": "Schedule FERA Family Electric Rate Assistance Program",
    "urpx:modifierUniqueIdentifier": "FERA",
    "urpx:initialEffectiveDate": "2010-01-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sdge:fera-2026-04-01",
      "urpx:version": "2026-04-01",
      "urpx:modifierVersionNumber": "2026-04-01",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Family Electric Rate Assistance (FERA) program — moderate-income tier discount applied as an overlay to any SDG&E residential base rate plan (Schedule DR, DR-SES, EV-TOU, EV-TOU-2, EV-TOU-5, TOU-DR, TOU-DR1, TOU-DR2, TOU-ELEC). CPUC-mandated program serving households whose income is just above the CARE eligibility ceiling but still constrained — Lower-Middle Income tier defined by Schedule FERA Special Condition 1: 200% + $1 through 250% of the Federal Poverty Limit, requires 3+ persons in household, NOT applicable to customers receiving CARE or DM service. FERA provides two distinct benefits: (1) a 50% Base Services Charge reduction (modeled as $-0.39655/day BSC adjustment, taking the standard $0.79343/day BSC down to the FERA $0.39688/day per the SDG&E TOU-DR1 base rate sheet), and (2) an 18% line-item bill discount applied to the total bill less any minimum bill amount or base services charge (NOT MODELED — URPX has no percentage-of-bill primitive, urpx-org/urpx#24 OPEN). Bill calculation correctness with this modifier captures the BSC reduction but underrepresents the full FERA customer benefit by the 18% percentage discount. FERA Medical Baseline customers also receive Medical Baseline Program co-benefits via Schedule E-MEDICAL (NOT modeled — blocked on urpx-org/urpx#32 OPEN, additive baseline allowance vocabulary). Sheet 3 Special Condition 9 also documents EV Submetering applicability — FERA discounts apply to both primary-meter load and submetered EV load — not separately modeled here because base SDG&E filings don't track EV submeter load distinctly.",
      "urpx:effectiveDateTime": "2026-04-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
