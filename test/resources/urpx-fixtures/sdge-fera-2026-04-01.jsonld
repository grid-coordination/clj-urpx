      "urpx:hasCoverageClaim": {
        "@id": "sdge:cc-fera-2026-04-01",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "sdge:cc-fera-2026-04-01-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "This filing carries one piece of the FERA benefit, the Base Services Charge reduction from $0.79343 to $0.39688 per day, modeled as a $0.39655 per day credit. The larger piece is missing: Sheet 1 grants a separate line-item bill discount of 18 percent applied to the total bill less any minimum bill amount or base services charge, and a URPX price is a per-unit dollar amount with no way to state a percentage of a computed bill, so nothing in the graph reflects it. Three further published provisions are absent. The alternative form of the fixed-charge benefit on Sheet 1, a 50 percent minimum bill in place of a reduced base services charge, which is the form it takes on Schedule EV-TOU, a plan this overlay declares itself applicable to and which has a $0.413 per day minimum bill rather than a base services charge. The Medical Baseline co-benefits that Sheet 1 extends to FERA Medical Baseline customers under Schedule E-MEDICAL pursuant to D.25-09-006, for which no filing exists in this corpus. And Special Condition 9 EV Submetering, under which the FERA discount applies to the submetered EV charging load as well as to the load at the primary meter where the equipment meets the D.22-08-024 submetering protocol. Eligibility is expressed as residential customer kind plus enrollment in the FERA program, so two published qualifying conditions are not present as data: the requirement of three or more persons in the household, and the Special Condition 1 income band ($42,301 to $52,875 for a one or two person household rising to $108,301 to $135,375 for eight, with $11,000 to $13,750 added per additional person, stated as 200 percent plus $1 through 250 percent of the Federal Poverty Limit). Special Conditions 2 through 6 (application and recertification, commencement, verification, notice of change, and rebilling for periods of ineligibility) are customer-administration procedures rather than rates, and their absence is a scope decision.",
          "urpx:evaluatedOn": "2026-09-21T00:00:00"
        }
      }
    }
