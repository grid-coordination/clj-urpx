      "urpx:forRatePlan": {
        "@id": "cpau:e-14"
      },
      "urpx:hasCoverageClaim": {
        "@id": "cpau:cc-e-14-2025-07-01",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "cpau:cc-e-14-2025-07-01-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "The Section C rate table of the published Schedule E-14 is fully represented: all seventeen fixture ratings (the 400 watt mercury-vapor lamp, four high pressure sodium vapor ratings, five LED ratings and seven traffic signal and speed sign types) are priced, as is the Section D.2 switching surcharge of $2.50 per month. What is not represented is the conditions the schedule attaches to those rates. Section A limits the schedule to street and highway lighting installations at service voltages from 120 to 480, and this filing's eligibility rule states no voltage condition. Section D.2 makes the switching surcharge conditional twice over, waiving it where each separately switched circuit carries at least 10 kilowatts of lamp load and waiving it again where the switching installation is made for CPAU's convenience; the 10 kilowatt threshold survives only in the name of the metric the charge counts and the convenience waiver only in prose, so a consumer computing a bill has to apply both by hand. Section D.3 conditions the whole rate table on the lamps running to a CPAU-approved burning schedule not exceeding 4,100 hours per year, which is likewise prose. Section D.5 is a hole in the price list rather than a missing condition: a customer who installs a lamp rating not on the schedule is billed at an interim rate CPAU prepares from its own estimated costs until that rating is added, and no such rate is published, so the eighteen prices here are not exhaustive of what an E-14 bill can carry. Two further Section D provisions are out of scope rather than missing: D.1's rule that the customer bears the cost of underground connections is a construction cost and not a rate, and D.4's maintenance terms describe what the per-lamp rate already includes.",
          "urpx:evaluatedOn": "2026-09-21T00:00:00"
        }
      }
    }
  }
}
