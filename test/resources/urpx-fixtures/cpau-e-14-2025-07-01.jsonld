  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "cpau:e-14",
    "urpx:name": "Street Lights",
    "urpx:ratePlanUniqueIdentifier": "CPAU-E-14",
    "urpx:initialEffectiveDate": "2025-07-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "cpau:e-14-2025-07-01",
      "urpx:version": "1.0",
      "urpx:effectiveDateTime": "2025-07-01T00:00:00",
      "urpx:description": "CPAU Schedule E-14 (Street Lights), effective 2025-07-01. Flat per-fixture-per-month rates for street and highway lighting installations (and related traffic signals) owned by governmental agencies other than the City of Palo Alto. CPAU supplies electricity, performs switching, and maintains lamps and glassware. 16 lamp types (mercury-vapor, HPSV, LED) + 6 traffic-signal types + 1 switching surcharge = 23 PriceDefinitions; one MetricInput per fixture-type-count. Section D.5 interim-rate provision (for lamps not on the schedule) is documented in prose only — not modeled. Section D.3 annual burning schedule (4100 hours/year operational rule) is also prose-only.",
      "urpx:customerChoice": {
        "@id": "urpx:mandatoryChoice"
      },
      "urpx:isDefault": true,
      "urpx:changeReason": {
        "@id": "urpx:initial"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "@id": "cpau:e14-dsr",
        "urpx:name": "CPAU Schedule E-14 (effective 2025-07-01)",
        "urpx:fileName": "e-14-effective-2025-07-01.pdf",
        "urpx:url": "https://www.paloalto.gov/files/assets/public/v/4/utilities/rates-schedules-for-utilities/city-facility-utility-rates/e-14-effective-2025-07-01.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:dateRetrieved": "2026-04-30"
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "cpau:e14-er-eligibility",
          "urpx:name": "Governmental agency street/highway lighting (other than City of Palo Alto)",
          "urpx:description": "Applies to street and highway lighting installations owned by any governmental agency other than the City of Palo Alto, where CPAU elects to operate and maintain the installation (supplying electricity, performing switching, and maintaining lamps and glassware). Per Section A of the published Schedule E-14.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "cpau:e14-cx-eligibility",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "cpau:e14-bn-eligibility-and",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e14-cn-non-residential",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "cpau:e14-cn-non-residential-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:hasCustomerKind"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "cpau:e14-cn-non-residential-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:nonResidentialKind"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e14-cn-customer-class",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e14-cn-customer-class-left-operand",
                    "urpx:customConditionProperty": "customerClass"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e14-cn-customer-class-right-operand",
                    "urpx:stringValue": "Governmental Agency"
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "cpau:e14-cn-installation-type",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e14-cn-installation-type-left-operand",
                    "urpx:customConditionProperty": "installationType"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "cpau:e14-cn-installation-type-right-operand",
                    "urpx:stringValue": "Street/highway lighting"
                  }
                }
              ],
              "urpx:logicExpression": "hasCustomerKind = nonResidentialKind AND customerClass = 'Governmental Agency' AND installationType = 'Street/highway lighting'"
            }
          }
        }
      ],
