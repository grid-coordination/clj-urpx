          "urpx:hasLedger": [
            {
              "@type": "urpx:Ledger",
              "@id": "ladwp:lifeline-ledger-subsidy",
              "urpx:name": "Lifeline Subsidy Credit",
              "urpx:ledgerType": {
                "@id": "urpx:bundledLedger"
              },
              "urpx:referencesMetricInput": {
                "@id": "ladwp:lifeline-mi-meter-count"
              }
            }
          ],
          "urpx:hasPriceDefinition": [
            {
              "@type": "urpx:PriceDefinition",
              "@id": "ladwp:lifeline-pd-subsidy-2008-09-01",
              "urpx:name": "Lifeline Subsidy Credit ($-35.42/2-months, modeled as $-0.5817/day = $35.42/60.875 days average bimonthly period)",
              "urpx:chargeType": {
                "@id": "urpx:creditMisc"
              },
              "urpx:chargeCategory": {
                "@id": "urpx:discount"
              },
              "urpx:billPortion": {
                "@id": "urpx:bundledPortion"
              },
              "urpx:baseQuantity": "1",
              "urpx:hasCalculationMethod": {
                "@type": "urpx:CalculationMethod",
                "urpx:intervalDuration": "P1D"
              },
              "urpx:referencesLedger": {
                "@id": "ladwp:lifeline-ledger-subsidy"
              }
            }
          ]
        }
      },
      "urpx:hasPrices": {
