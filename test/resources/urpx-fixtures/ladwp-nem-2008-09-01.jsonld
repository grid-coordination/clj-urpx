            "urpx:scheme": {
              "@id": "urpx:eiaScheme"
            },
            "skos:notation": "11208"
          }
        }
      },
      "urpx:forRatePlanModifier": {
        "@id": "ladwp:nem"
      },
      "urpx:hasCoverageClaim": {
        "@id": "ladwp:nem-2008-09-01-coverage",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true
      }
    }
  }
}
