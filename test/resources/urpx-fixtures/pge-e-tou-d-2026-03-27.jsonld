      "urpx:hasRatePlan": {
        "@type": "urpx:RatePlan",
        "@id": "pge:e-tou-d",
        "urpx:name": "Residential Time-Of-Use (Peak Pricing 5-8 p.m. Non-Holiday Weekdays)",
        "urpx:initialEffectiveDate": "2018-03-01",
        "urpx:timezoneIdentifier": "America/Los_Angeles",
        "urpx:hasRatePlanVersion": {
          "@type": "urpx:RatePlanVersion",
          "@id": "pge:e-tou-d-2026-03-27",
          "urpx:description": "Voluntary residential TOU schedule with a narrow weekday-only peak window (5-8 p.m. Mon-Fri non-holiday). Holidays (New Year's, Presidents, Memorial, Independence, Labor, Veterans, Thanksgiving, Christmas) are off-peak even when they fall on a weekday — modeled via urpx:includeHolidays/includeNonHolidays booleans on TimeBracket. Customers pay a daily base services charge that varies by income tier (CARE / FERA / standard). E-TOU-D has NO baseline credit and NO Conservation Incentive Adjustment (unlike E-TOU-C / E-1) — over- and under-baseline kWh are billed at the same rate. Vintage PCIA for CCA/DA/TBS customers is modeled as a sibling RatePlanModifier in this file.",
          "urpx:effectiveDateTime": "2026-03-27T00:00:00",
          "urpx:changeReason": {
            "@id": "urpx:rateCase"
          },
          "urpx:priceCurrency": "USD",
          "urpx:commodity": {
            "@id": "urpx:electricity"
          },
          "urpx:serviceRole": {
            "@id": "urpx:bundledServiceRole"
          },
          "urpx:customerChoice": {
            "@id": "urpx:voluntaryChoice"
          },
