      "urpx:hasCoverageClaim": {
        "@id": "sce:cc-fera-2026-03-20",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "sce:cc-fera-2026-03-20-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "Special Condition 9 on Sheet 18 of Schedule TOU-D grants FERA households an 18.0 percent discount off their bill prior to any applicable taxes and late payment charges, and this filing does not represent it. The filing carries the two line-item adjustments from the same Special Condition: the Base Services Charge Surcharge exemption of $0.064 per meter per day and the Base Services Charge credit adjustment of $(0.201) per meter per day, together $(0.265) per meter per day. FERA grants no Wildfire Fund Non-Bypassable Charge or Fixed Recovery Charge exemption, so the absence of those credits is faithful rather than a gap. A consumer should read this filing as the small, fixed part of the FERA benefit, with the percentage discount that dominates it left to prose. Note also that the values modeled here are taken from TOU-D Sheet 18 rather than from Schedule D-FERA itself, because Schedule D-FERA Sheet 1 was not reissued when these values were updated and still shows the superseded $0.063 and $(0.202). The enrollment provisions of Special Condition 9, the application and eligibility declaration, the rebilling of ineligible periods, and the exclusion of customers taking the CARE discount, are out of scope rather than missing.",
          "urpx:evaluatedOn": "2026-09-21T00:00:00"
        }
      }
    }
