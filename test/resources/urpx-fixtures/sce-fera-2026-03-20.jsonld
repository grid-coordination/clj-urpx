  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sce:fera",
    "urpx:name": "Family Electric Rate Assistance (FERA) Discount",
    "urpx:modifierUniqueIdentifier": "FERA",
    "urpx:initialEffectiveDate": "2005-04-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sce:fera-2026-03-20",
      "urpx:version": "2026-03-20",
      "urpx:modifierVersionNumber": "2026-03-20",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Family Electric Rate Assistance (FERA) program — income-qualified bill discount for moderate-income households with three or more residents, applied as an overlay to any SCE residential base rate plan. CPUC-mandated program; SCE's implementation is defined in Schedule D-FERA and articulated in each base schedule's Special Condition 9. Eligibility: household income at-or-below 250% of Federal Poverty Guidelines AND minimum 3+ household members; customers receiving CARE Discount are NOT eligible for FERA simultaneously. FERA provides two distinct benefits: (1) an 18.0% bill discount on the pre-tax subtotal (NOT MODELED — URPX has no percentage-of-bill primitive; same upstream-vocabulary gap as the CARE modifier), (2) exemption from the Base Services Charge Surcharge component (modeled as $-0.063/meter/day credit) and a Base Services Charge credit adjustment of $-0.202/meter/day (modeled as a separate credit). Net per-meter-per-day credit from BSC adjustments: $-0.265/meter/day. Unlike CARE, FERA does NOT include WFC or FRC exemptions — FERA customers continue to pay the Wildfire Fund Non-Bypassable Charge ($0.00595/kWh) and Fixed Recovery Charge ($0.00198/kWh) at the standard rates. Bill calculation correctness with this modifier captures the BSC adjustments but underrepresents the full FERA customer benefit by the 18.0% percentage discount. Future filing versions will replace this gap with structured PriceDefinitions when URPX adds percentage-of-bill vocabulary.",
      "urpx:effectiveDateTime": "2026-03-20T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
