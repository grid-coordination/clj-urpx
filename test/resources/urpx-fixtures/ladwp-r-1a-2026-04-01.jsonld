  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "ladwp:r-1a",
    "urpx:name": "Schedule R-1(A) Residential Service — Standard",
    "urpx:ratePlanUniqueIdentifier": "R-1A",
    "urpx:initialEffectiveDate": "2008-09-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "ladwp:r-1a-2026-04-01",
      "urpx:description": "LADWP's standard residential rate (the default for ~95% of LADWP residential customers, ~1.34M of 1.41M). Three-tier inclining-block structure with zone-specific tier breakpoints (Zone 1 coastal: 350/1050 kWh boundaries; Zone 2 inland: 500/1500 kWh boundaries) and season-specific Tier 3 rates (high-season Tier 3 rate $0.21702/kWh; low-season Tier 3 collapses to Tier 2 rate $0.13001/kWh). Power Access Charge varies by tier ($2.30/$7.90/$22.70 per month for Tier 1/2/3 respectively) — same per-tier value across both zones. Customer-facing all-in $/kWh = energy charge (this snapshot) + sum of seven pass-through Adjustment Factors (ECA + ESA + RCA + IRCA + VEA + CRPSEA + VRPSEA, refreshed quarterly by LADWP). The factors captured here are the Apr-Jun 2026 quarterly values; subsequent quarterly refreshes will be filed as new RatePlanVersions. Base rates derive from LADWP's 2019-07-01 Electric Rate Summary, which has not changed since (rate evolution is captured via the quarterly factors). Modifiers not included: EZ-Save Lifeline subsidy (income-qualified credit, see grid-coordination/urpx-rate-plans#16), NEM Service Rider (net energy metering for solar customers), REO Service Rider (Renewable Energy Option Green Power program). Minimum Charge ($10/month, plus ECA + ESA + RCA per Special Conditions) modeled as a flat per-month service charge; bill resolution decides whether it applies (minimum-bill semantics).",
      "urpx:effectiveDateTime": "2026-04-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": true,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "Electric_Rate_Summary_effective_7_1_2019_with_factors_referenced_rev1.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.ladwp.com/sites/default/files/documents/Electric_Rate_Summary_effective_7_1_2019_with_factors_referenced_rev1.pdf",
        "urpx:dateRetrieved": "2026-04-30",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 1
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "ladwp:er-residential-r-1a",
          "urpx:name": "Eligibility for Schedule R-1(A) Standard Residential Service",
          "urpx:description": "Applicable to residential service in single-family dwellings, single-family-with-guest-house, individually-metered accommodations, and separately-metered common areas of condominiums and cooperatives devoted primarily to residential uses. Battery chargers, motors, and appliances conforming to applicable electrical codes and the Department's Rules may be served under this schedule. Energy and capacity requirements must not exceed those for Small General Service Schedule A-1. NOT applicable to single-family residential customers with an on-site transformer dedicated solely to that individual customer (those customers take service on Schedule A-1 instead). Not a TOU schedule; opt-in to TOU is via Schedule R-1(B).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "ladwp:cx-residential-r-1a",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "ladwp:cn-residential-r-1a",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "ladwp:cn-residential-r-1a-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "ladwp:cn-residential-r-1a-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:residentialKind"
                }
              }
            }
          }
        }
      ],
