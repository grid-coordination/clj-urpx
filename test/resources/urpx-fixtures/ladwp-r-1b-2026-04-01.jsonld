  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "ladwp:r-1b",
    "urpx:name": "Schedule R-1(B) Residential Service — Time-of-Use",
    "urpx:ratePlanUniqueIdentifier": "R-1B",
    "urpx:initialEffectiveDate": "2008-09-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "ladwp:r-1b-2026-04-01",
      "urpx:description": "LADWP's voluntary opt-in residential time-of-use schedule (and mandatory for residential customers whose annual monthly average consumption reaches or exceeds 3,000 kWh in the preceding 12-month period). Three TOU tiers — High Peak (1pm-5pm M-F), Low Peak (10am-1pm + 5pm-8pm M-F), Base (8pm-10am M-F + all weekend). TOU windows do NOT vary by season; only the per-tier prices vary between High Season (June-September) and Low Season (October-May). High-Peak summer rate ($0.15858/kWh) is materially higher than other periods; in winter the High Peak rate collapses to the Low Peak rate ($0.10018) — same flattening pattern as R-1A's Tier 3 winter collapse. Service Charge is a flat $12.00/month, independent of tier or season. Customer-facing all-in $/kWh = TOU energy charge (this snapshot) + sum of seven pass-through Adjustment Factors (ECA + ESA + RCA + IRCA + VEA + CRPSEA + VRPSEA), refreshed quarterly by LADWP. The factors captured here are the Apr-Jun 2026 quarterly values; subsequent quarterly refreshes will be filed as new RatePlanVersions. Mandatory-stay rule: customers electing Rate B may not revert to Rate A before 12 months have elapsed. Electric Vehicle Discount of $-0.025/kWh is referenced on the rate-summary sheet but is conditional on EV ownership; modeling deferred to a separate RatePlanModifier issue (will be filed as a child of grid-coordination/urpx-rate-plans#16 for the secondary LADWP epic).",
      "urpx:effectiveDateTime": "2026-04-01T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "Electric_Rate_Summary_effective_7_1_2019_with_factors_referenced_rev1.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.ladwp.com/sites/default/files/documents/Electric_Rate_Summary_effective_7_1_2019_with_factors_referenced_rev1.pdf",
        "urpx:dateRetrieved": "2026-04-30",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 2,
        "urpx:pageEnd": 2
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "ladwp:er-residential-r-1b",
          "urpx:name": "Eligibility for Schedule R-1(B) Time-of-Use Residential Service",
          "urpx:description": "Applicable to residential service in single-family dwellings, single-family-with-guest-house, individually-metered accommodations, and separately-metered common areas of condominiums and cooperatives devoted primarily to residential uses. Energy and capacity requirements must not exceed those for Small General Service Schedule A-1. NOT applicable to single-family residential customers with an on-site transformer dedicated solely to that individual customer (those take service on Schedule A-1). Mandatory enrollment for residential customers whose annual monthly average consumption reaches or exceeds 3,000 kWh in any preceding 12-month period. Below that threshold, customers may voluntarily elect either R-1(A) or R-1(B); customers transferring from R-1(B) to R-1(A) may not revert to R-1(B) before 12 months have elapsed.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "ladwp:cx-residential-r-1b",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "ladwp:cn-residential-r-1b",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "urpx:referencesValue": {
                  "@id": "urpx:residentialKind"
                }
              }
            }
          }
        }
      ],
