  "@type": "urpx:URPXPackage",
  "@id": "smud:doc-cpp-2026-01-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "smud:cpp",
    "urpx:name": "Schedule R-TOD Optional Critical Peak Pricing (CPP) Rate (RTC1)",
    "urpx:modifierUniqueIdentifier": "RTC1",
    "urpx:initialEffectiveDate": "2026-01-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "smud:cpp-2026-01-01",
      "urpx:version": "2026-01-01",
      "urpx:modifierVersionNumber": "2026-01-01",
      "urpx:changeReason": {
        "@id": "urpx:initial"
      },
      "urpx:description": "SMUD's Optional Critical Peak Pricing Rate (regulatory rate category RTC1) — a customer-elected DR overlay applied on top of the customer's R-TOD base RatePlan (smud:tod-5-8pm RT02 or smud:tod-low-use RTL1). Maximum 30,000 customer enrollment cap. Mandatory for customers who have accepted a SMUD storage incentive under certain Solar+Storage Rate incentive programs (duration per SMUD program rules on smud.org); voluntary for other R-TOD customers. Compensation has TWO components, both updated annually at SMUD's discretion and posted on smud.org (current values per the SMUD residential rates HTML page, retrieved 2026-05-04): (1) During CPP Events: customer charged at applicable TOU period rate PLUS the CPP Event Price of +$0.5000/kWh (events range from 1-4 hours but not more than once/day, called any time of day during summer months including holidays and weekends, up to 50 hours per summer total, day-ahead announcement, may be same-day in system emergencies, energy exported to the grid during Events compensated at the same +$0.5000/kWh Event Price). (2) During non-Event summer hours: customer receives a discount of -$0.0200/kWh on Mid-Peak prices ($0.2139 → $0.1939) and -$0.0200/kWh on Off-Peak prices ($0.1550 → $0.1350) — Peak prices are unchanged ($0.3765, same as RT02). Non-summer pricing is identical to the underlying R-TOD base (no CPP discount or surcharge). Ties to SMUD's My Energy Optimizer thermostat program. CPP Events span multiple time-of-day periods. Source PDF (1-R-TOD.ashx Sec II.C and III.C) carries the regulatory framework but does NOT carry the actual Event Price or Discount values — those are published annually on the SMUD residential rates HTML page (cited as the modifier's authoritative price source). Same source PDF + Board Resolution (25-06-15 adopted June 19 2025) as the smud:tod-5-8pm and smud:tod-low-use sub-rates that share the R-TOD schedule umbrella. CPP Rate base prices per time-of-day period are the SAME as RT02 (per Sec II.C.1) — RTC1 doesn't have its own base rate trajectory. Discount Prices reference touPeriodNumber=2 (Mid-Peak) and touPeriodNumber=3 (Off-Peak) — the resolver matches these against the BASE RatePlan's Summer Mid-Peak/Off-Peak periods (RT02 and RTL1 share the same touPeriodNumber assignments). The Event Charge uses urpx:hasDynamicPricing with dynamicPricingType=urpx:criticalPeakPricing + updateFrequency=urpx:eventTriggeredUpdates + a urpx:PriceUpdateRule whose description carries the trigger semantics (called by SMUD ops, summer-only, day-ahead, etc.) — the canonical URPX v0.5.1 vocabulary for event-driven pricing demonstrated in the urpx-org/urpx PG&E B6-PDP example. A complementary ApplicabilityRule with month=summer is retained on the Event Charge Price for resolver-evaluable seasonal gating; the day-of and hour-of event-window gating are consumer-side (price-server) responsibilities since the resolver does not yet evaluate DynamicPricing semantically.",
      "urpx:effectiveDateTime": "2026-01-01T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "smud:tod-5-8pm"
        },
        {
          "@id": "smud:tod-low-use"
        }
      ],
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "SMUD_SCHEDULE_R-TOD.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://www.smud.org/-/media/Documents/Rate-Information/Rates/1-R-TOD.ashx",
        "urpx:dateRetrieved": "2026-05-04",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 1,
        "urpx:pageEnd": 5,
        "urpx:leafStart": "R-TOD-1",
        "urpx:leafEnd": "R-TOD-5"
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "smud:cpp-2026-01-01-er-eligible",
          "urpx:name": "CPP-elected residential customer",
          "urpx:description": "Customer is a residential customer enrolled in SMUD's Optional Critical Peak Pricing Rate (RTC1). Eligibility paths (Sec I.C.1): (a) voluntary enrollment for any R-TOD customer participating in a qualifying program (e.g., My Energy Optimizer thermostat program); (b) MANDATORY enrollment for customers who have accepted a storage incentive under certain SMUD Solar+Storage Rate incentive programs, for a duration determined by SMUD program rules posted on smud.org. Maximum 30,000 customers may be enrolled at any given time (Sec I.C.2). Customer must be on R-TOD base rate (RT02 or RTL1) — CPP applies on top of either base. Encoded as a 'Program Enrollment' = 'CPP' predicate; the storage-incentive-mandatory and 30,000-cap conditions are documented in description prose but not modeled as ConditionExpression operands.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "smud:cpp-2026-01-01-cx-eligible",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "smud:cpp-2026-01-01-bn-residential-and-enrolled",
              "urpx:operator": {
                "@id": "urpx:andOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "smud:cpp-2026-01-01-cn-residential",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "smud:cpp-2026-01-01-cn-residential-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:hasCustomerKind"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "smud:cpp-2026-01-01-cn-residential-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:residentialKind"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "smud:cpp-2026-01-01-cn-program-enrollment",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "smud:cpp-2026-01-01-cn-program-enrollment-left-operand",
                    "urpx:customConditionProperty": "Program Enrollment"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "smud:cpp-2026-01-01-cn-program-enrollment-right-operand",
                    "urpx:stringValue": "CPP"
                  }
                }
              ]
            }
          }
        }
      ],
