          "urpx:hasPriceDefinition": [
            {
              "@type": "urpx:PriceDefinition",
              "@id": "smud:cpp-pd-event-charge",
              "urpx:name": "CPP Event Energy Charge — applies during called CPP Event windows (any time of day in summer months, day-ahead announced; gated via Price.hasDynamicPricing + summer-month ApplicabilityRule)",
              "urpx:chargeType": {
                "@id": "urpx:adjustmentPowerCost"
              },
              "urpx:chargeCategory": {
                "@id": "urpx:adjustment"
              },
              "urpx:billPortion": {
                "@id": "urpx:bundledPortion"
              },
              "urpx:referencesLedger": {
                "@id": "smud:cpp-ledger-event-charge"
              }
            },
            {
              "@type": "urpx:PriceDefinition",
              "@id": "smud:cpp-pd-summer-mid-peak-discount",
              "urpx:name": "CPP Summer Mid-Peak Discount — gates on base RatePlan's Summer Mid-Peak period (touPeriodNumber=2 in RT02 and RTL1)",
              "urpx:chargeType": {
