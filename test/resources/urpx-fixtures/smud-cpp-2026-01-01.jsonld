              }
            }
          ]
        }
      },
      "urpx:hasPrices": {
        "@type": "urpx:Prices",
        "@id": "smud:cpp-2026-01-01-prices",
        "urpx:hasPrice": [
          {
            "@type": "urpx:Price",
            "@id": "smud:cpp-price-event-charge-2026-01-01",
            "urpx:referencesPriceDefinition": {
              "@id": "smud:cpp-pd-event-charge"
            },
            "urpx:startDate": "2026-01-01",
            "urpx:name": "CPP Event Energy Charge",
            "urpx:unitPrice": "0.5000",
            "urpx:hasApplicabilityRule": {
              "@type": "urpx:ApplicabilityRule",
              "@id": "smud:cpp-2026-01-01-ar-event-charge",
              "urpx:name": "Resolver-evaluable seasonal gate (Jun-Sept); the day-and-hour event-window gate is consumer-side via hasDynamicPricing/PriceUpdateRule",
              "urpx:month": [
                "--06",
                "--07",
                "--08",
                "--09"
              ]
            },
            "urpx:hasDynamicPricing": {
              "@type": "urpx:DynamicPricing",
              "@id": "smud:cpp-2026-01-01-dp-event-charge",
              "urpx:dynamicPricingType": {
                "@id": "urpx:criticalPeakPricing"
              },
              "urpx:updateFrequency": {
                "@id": "urpx:eventTriggeredUpdates"
              },
              "urpx:hasPriceUpdateRule": {
                "@type": "urpx:PriceUpdateRule",
                "@id": "smud:cpp-2026-01-01-pur-event-trigger",
                "urpx:name": "SMUD CPP Event Day Trigger Rule",
                "urpx:description": "CPP Events are called by SMUD operations during summer months (June 1 - September 30) when system conditions warrant load reduction. Each event lasts 1-4 hours, max one event per day, up to 50 hours per summer total. Events may be called during ANY hour of the day (not restricted to TOU Peak hours), including holidays and weekends. Day-ahead announcement is the standard cadence; in the event of a system emergency, SMUD may announce same-day. The +$0.5000/kWh adder applies to the customer's metered consumption AND to energy exported to the grid during the event window — bidirectional event-window pricing. The Event Charge value is updated annually at SMUD's discretion and posted on www.smud.org. priceSource is intentionally omitted from this DynamicPricing — none of the v0.5.1 PriceSourceValue enum members (algorithmicSource, capacityAuctionSource, demandForecastSource, gasIndexSource, manualOverrideSource, renewableForecastSource, wholesaleMarketSource) cleanly fits SMUD's case. SMUD operates as its own Balancing Authority distinct from CAISO BA, while participating in CAISO-operated markets (EIM since 2019, EDAM more recently); CPP event calls are a SMUD operations decision based on local system conditions plus market signals. Closest fits: demandForecastSource (events partly driven by SMUD's load forecasts in heat-wave conditions) or manualOverrideSource (ultimate decision is operator discretion). Documenting as a small upstream observation only — not blocking."
              }
            }
          },
          {
            "@type": "urpx:Price",
            "@id": "smud:cpp-price-summer-mid-peak-discount-2026-01-01",
            "urpx:referencesPriceDefinition": {
              "@id": "smud:cpp-pd-summer-mid-peak-discount"
            },
            "urpx:startDate": "2026-01-01",
            "urpx:name": "Summer Mid-Peak CPP Discount",
            "urpx:unitPrice": "-0.0200",
            "urpx:touPeriodNumber": 2
          },
          {
            "@type": "urpx:Price",
            "@id": "smud:cpp-price-summer-off-peak-discount-2026-01-01",
            "urpx:referencesPriceDefinition": {
              "@id": "smud:cpp-pd-summer-off-peak-discount"
            },
            "urpx:startDate": "2026-01-01",
            "urpx:name": "Summer Off-Peak CPP Discount",
            "urpx:unitPrice": "-0.0200",
            "urpx:touPeriodNumber": 3
          }
        ]
      },
