      "urpx:hasPrices": {
        "@type": "urpx:Prices",
        "@id": "sce:tou-d-prime-cpp-2026-03-20-prices",
        "urpx:hasPrice": [
          {
            "@type": "urpx:Price",
            "@id": "sce:tou-d-prime-cpp-price-event-charge-2026-03-20",
            "urpx:referencesPriceDefinition": {
              "@id": "sce:tou-d-prime-cpp-pd-event-charge"
            },
            "urpx:startDate": "2026-01-01",
            "urpx:name": "CPP Event Energy Charge",
            "urpx:unitPrice": "0.80000",
            "urpx:hasDynamicPricing": {
              "@type": "urpx:DynamicPricing",
              "@id": "sce:tou-d-prime-cpp-2026-03-20-dp-event-charge",
              "urpx:dynamicPricingType": {
                "@id": "urpx:criticalPeakPricing"
              },
              "urpx:priceSource": {
                "@id": "urpx:wholesaleMarketSource"
              },
              "urpx:updateFrequency": {
                "@id": "urpx:eventTriggeredUpdates"
              },
              "urpx:hasPriceUpdateRule": {
                "@type": "urpx:PriceUpdateRule",
                "@id": "sce:tou-d-prime-cpp-2026-03-20-pur-event-trigger",
                "urpx:name": "PRIME-CPP Event Day Trigger Rule",
                "urpx:description": "PRIME-CPP Events are called by SCE — typically 12-15 events per calendar year — based on system grid stress (CAISO Flex Alert conditions, peak summer heat waves, supply shortfalls). Day-before notification by 3 p.m. for next-day events. The Event Energy Charge of +$0.80000/kWh applies during 4 p.m.-9 p.m. on Event days, in addition to the customer's underlying PRIME base rate for the period. PRIME-CPP is restricted to Bundled Service Customers (DA / CCA ineligible per Sheet 16 SC 4.d) and is incompatible with most other DR programs (grandfathered Schedule D-SDP dual participants under Option A-CPP / B-CPP excepted, capped at the Maximum Available Credit). First 12 months of CPP enrollment are protected by Bill Protection: customer guaranteed not to pay more than equivalent non-CPP option (NOT modeled here — year-long calculation doesn't fit per-bill shape)."
              }
            }
          },
          {
            "@type": "urpx:Price",
            "@id": "sce:tou-d-prime-cpp-price-non-event-credit-2026-03-20",
