  "@type": "urpx:URPXPackage",
  "@id": "sce:doc-tou-d-prime-cpp-2026-03-20",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlanModifier": {
    "@type": "urpx:RatePlanModifier",
    "@id": "sce:tou-d-prime-cpp",
    "urpx:name": "Schedule TOU-D Option PRIME-CPP (Critical Peak Pricing variant of Option PRIME)",
    "urpx:modifierUniqueIdentifier": "TOU-D-PRIME-CPP",
    "urpx:initialEffectiveDate": "2022-06-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanModifierVersion": {
      "@type": "urpx:RatePlanModifierVersion",
      "@id": "sce:tou-d-prime-cpp-2026-03-20",
      "urpx:version": "2026-03-20",
      "urpx:modifierVersionNumber": "2026-03-20",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:description": "Critical Peak Pricing (CPP) variant of Option PRIME. Customer-elected sub-option that overlays event-window charges and non-event-window credits onto the base PRIME rate structure. SCE may call any day a CPP Event (12-15 events per calendar year, day-before notification) — on Event days during 4 p.m.-9 p.m., a CPP Event Energy Charge of +$0.80000/kWh applies. On Summer non-Event days during 4 p.m.-9 p.m., a CPP Non-Event Energy Credit of -$0.15170/kWh applies (no credit on exported generation). PRIME-CPP is restricted to Bundled Service Customers (DA / CCA ineligible per Sheet 16 SC 4.d) and is incompatible with most other DR programs (grandfathered Schedule D-SDP dual participants under Option A-CPP / B-CPP excepted, capped at the Maximum Available Credit of -$0.58794/kWh per Summer Season). First 12 months of CPP enrollment are protected by Bill Protection: customer guaranteed not to pay more than equivalent non-CPP option (NOT modeled here — year-long calculation doesn't fit per-bill shape). The CPP Event Energy Charge uses urpx:hasDynamicPricing with dynamicPricingType=urpx:criticalPeakPricing + priceSource=urpx:wholesaleMarketSource + updateFrequency=urpx:eventTriggeredUpdates + a urpx:PriceUpdateRule whose description carries the SCE-specific event-trigger semantics — the canonical URPX v0.5.1 vocabulary for event-driven pricing demonstrated in the urpx-org/urpx PG&E B6-PDP example. The Non-Event Credit and Maximum Available Credit retain ApplicabilityRule + CustomOperandNode gating: the Non-Event Credit is the inverse polarity of the event gate (applies when 'Is CPP Event Today' = false), which DynamicPricing's vocabulary does not natively express; the Maximum Available Credit gates on a customer-attribute (Grandfathered D-SDP Dual Participation), unrelated to event status. Both remaining CustomOperandNode predicates are consumer-side billing-time evaluations.",
      "urpx:effectiveDateTime": "2026-03-20T00:00:00",
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:applicableToRatePlan": [
        {
          "@id": "sce:tou-d-prime"
        }
      ],
