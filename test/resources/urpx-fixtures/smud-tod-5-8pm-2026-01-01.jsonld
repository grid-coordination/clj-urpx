      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "smud:er-residential-tod-5-8pm",
          "urpx:name": "Eligibility for Schedule R-TOD Time-of-Day (5-8 p.m.) Rate",
          "urpx:description": "Applicable to single- and three-phase service for residential premises with digital communicating meter installed: individually- or dual-metered residences (single-family homes, duplexes, apartments, condominiums); general farm service where the meter also serves the residence or additional meters on a farm where electricity is solely for domestic purposes. Customers with NEM1 or SSR generation facilities approved on/after January 1, 2018 — or who establish service at a premises with such generation — are MANDATORILY enrolled in R-TOD (not eligible to opt out to the Fixed Rate). Master-metered service to qualifying multifamily accommodations or mobile home parks is NOT eligible. Otherwise customers may elect the Fixed Rate (Schedule R) as an alternative.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "smud:cx-residential-tod-5-8pm",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "smud:cn-residential-tod-5-8pm",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
