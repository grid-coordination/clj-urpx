  "@type": "urpx:URPXPackage",
  "@id": "sce:doc-tou-d-prime-2026-03-20",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "sce:tou-d-prime",
    "urpx:name": "Schedule TOU-D Time-Of-Use Domestic — Option PRIME",
    "urpx:ratePlanUniqueIdentifier": "TOU-D-PRIME",
    "urpx:initialEffectiveDate": "2020-09-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "sce:tou-d-prime-2026-03-20",
      "urpx:description": "Voluntary residential time-of-use schedule for customers with qualifying load-modifying electric technologies: electric vehicles (EVs/PHEVs), behind-the-meter (BTM) energy storage, or electric heat pumps for water or space heating. Mandatory for new solar customers under the Net Billing Tariff (NBT) since 2023. Summer on-peak 4:00 p.m.-9:00 p.m. weekdays — same windows as TOU-D-4-9PM, but with no Baseline Credit and a different rate-component structure tuned for higher-usage customers. Customers with separately-metered EV load receive an EV Meter Credit of $(0.446)/meter/day; customers using a submeter for EV load receive an EV Submeter Credit of $(0.152)/meter/day. Replaces the prior Basic Charge + Minimum Charge structure with an income-graduated Base Services Charge (BSC) of $0.794/meter/day per Decision 24-05-028, with a Deed-Restricted discount of $(0.332)/meter/day. CARE/FERA discounts (32.5% / 18%) and the related BSC surcharge exemption + BSC discount adjustments are documented in Special Conditions and modeled separately as RatePlanModifiers at ca/iou/sce/care/ and ca/iou/sce/fera/; the Deed-Restricted discount referenced above is modeled at ca/iou/sce/deed-restricted/. The 100% Medical Line Item Discount is documented in Special Conditions but its RatePlanModifier is not yet modeled (deferred). Climate Credit ($-36.00/household, semi-annually) is applied per Special Conditions.",
      "urpx:effectiveDateTime": "2026-03-20T00:00:00",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
        "@type": "urpx:DataSourceReference",
        "urpx:fileName": "ELECTRIC_SCHEDULES_TOU-D.pdf",
        "urpx:mediaType": {
          "@id": "urpx:applicationPdf"
        },
        "urpx:accessURL": "https://edisonintl.sharepoint.com/teams/Public/TM2/Shared%20Documents/Public/Regulatory/Tariff-SCE%20Tariff%20Books/Electric/Schedules/Residential%20Rates/ELECTRIC_SCHEDULES_TOU-D.pdf",
        "urpx:dateRetrieved": "2026-05-04",
        "urpx:dataSourceType": {
          "@id": "urpx:utilityWebsiteSource"
        },
        "urpx:pageStart": 6,
        "urpx:pageEnd": 7,
        "urpx:leafStart": "90941-E",
        "urpx:leafEnd": "90942-E"
      },
      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:tou-d-prime-2026-03-20-er-residential",
          "urpx:name": "Eligibility for Schedule TOU-D Option PRIME — residential customer",
          "urpx:description": "Available to customers eligible for service under Schedule D (Domestic): residential customers individually metered by SCE in single-family accommodations or individually-metered single-family dwellings in a Multifamily Accommodation. Customers must additionally meet at least one of the qualifying-technology conditions below (or be enrolled in NBT for new solar service). 12-month minimum stay applies for elective rate changes; customers may transfer to TOU-D-4-9PM, TOU-D-5-8PM, Schedule D, or other applicable residential schedules subject to that rule.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sce:tou-d-prime-2026-03-20-cx-residential",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
              "@id": "sce:tou-d-prime-2026-03-20-cn-residential",
              "urpx:operator": {
                "@id": "urpx:equalsOperator"
              },
              "urpx:leftOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "sce:tou-d-prime-2026-03-20-cn-residential-left-operand",
                "urpx:conditionProperty": {
                  "@id": "urpx:hasCustomerKind"
                }
              },
              "urpx:rightOperand": {
                "@type": "urpx:ObjectOperandNode",
                "@id": "sce:tou-d-prime-2026-03-20-cn-residential-right-operand",
                "urpx:referencesValue": {
                  "@id": "urpx:residentialKind"
                }
              }
            }
          }
        },
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:tou-d-prime-2026-03-20-er-qualifying-technology",
          "urpx:name": "Eligibility for Schedule TOU-D Option PRIME — qualifying electric technology or NBT enrollment",
          "urpx:description": "Customers must own or lease at least one of: a battery-electric vehicle (BEV) or plug-in hybrid (PHEV) — both map to urpx:evChargingDER since URPX's DERTypeValue enum does not distinguish them; behind-the-meter energy storage (subject to interconnection requirements); or an electric heat pump as primary water-heating or climate-control source. New solar customers must take service on TOU-D-PRIME under the Net Billing Tariff (NBT) effective 2023; the NBT condition is included as a fourth OR-leaf and does not require any of the qualifying technologies above. Existing customers on closed schedules TOU-D-A, TOU-D-B, or TOU-D-T may also enroll without confirming qualifying technology (modeling deferred — first-cut captures the four primary OR-paths).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sce:tou-d-prime-2026-03-20-cx-qualifying-technology",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
              "@id": "sce:tou-d-prime-2026-03-20-bn-qualifying-technology-or",
              "urpx:operator": {
                "@id": "urpx:orOperator"
              },
              "urpx:operandNodes": [
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sce:tou-d-prime-2026-03-20-cn-storage",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sce:tou-d-prime-2026-03-20-cn-storage-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:derType"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sce:tou-d-prime-2026-03-20-cn-storage-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:storageDER"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sce:tou-d-prime-2026-03-20-cn-ev-charging",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sce:tou-d-prime-2026-03-20-cn-ev-charging-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:derType"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sce:tou-d-prime-2026-03-20-cn-ev-charging-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:evChargingDER"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sce:tou-d-prime-2026-03-20-cn-heat-pump",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sce:tou-d-prime-2026-03-20-cn-heat-pump-left-operand",
                    "urpx:conditionProperty": {
                      "@id": "urpx:hasHVAC"
                    }
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:ObjectOperandNode",
                    "@id": "sce:tou-d-prime-2026-03-20-cn-heat-pump-right-operand",
                    "urpx:referencesValue": {
                      "@id": "urpx:airSourceHeatPump"
                    }
                  }
                },
                {
                  "@type": "urpx:ComparisonNode",
                  "@id": "sce:tou-d-prime-2026-03-20-cn-nbt",
                  "urpx:operator": {
                    "@id": "urpx:equalsOperator"
                  },
                  "urpx:leftOperand": {
                    "@type": "urpx:CustomOperandNode",
                    "@id": "sce:tou-d-prime-2026-03-20-cn-nbt-left-operand",
                    "urpx:customConditionProperty": "Program Enrollment"
                  },
                  "urpx:rightOperand": {
                    "@type": "urpx:CustomOperandNode",
