      "urpx:hasCoverageClaim": {
        "@id": "sce:cc-tou-d-prime-2026-03-20",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "sce:cc-tou-d-prime-2026-03-20-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "Two conditional credits on Sheet 6 are carried here without the conditions that gate them. The sheet labels them EV Meter Credit (Separately Metered EV Option) at $(0.451) per meter per day and EV Submeter Credit at $(0.152) per meter per day, and Special Conditions 6 and 19 restrict them to a customer with a separate SCE-provided electric vehicle meter and to a customer using a submeter meeting the Plug-In Electric Vehicle Submetering Protocol respectively. This filing states both as unconditional price definitions, so a consumer computing a bill will apply both to every Option PRIME customer. The two pilot bill discounts in Special Conditions 15 and 16 are also unrepresented: the San Joaquin Valley Disadvantaged Communities Pilot Bill Protection Discount (20 percent in years 1 through 5, then 10 or 20 percent in years 6 through 10) and the 20 percent Transitional Community Solar Discount. Option PRIME has no Baseline Credit line, so the baseline-allocation limitation affecting the other SCE residential options does not arise here. Several things are out of scope rather than missing: the Option PRIME-CPP prices printed on the same sheet are filed as a companion modifier overlay in this corpus rather than here; the Deed Restricted Base Services Charge adjustment of $(0.332) per meter per day, the CARE and FERA discount lines, and the Medical Baseline Credit line shown at 100.00 are cross-references to separate schedules each filed on its own; and the attestation-based eligibility of Special Condition 5, the twelve-month rate change restriction of Special Condition 7 and the Arrearage Management Plan of Special Condition 10 govern enrollment and account administration rather than price.",
          "urpx:evaluatedOn": "2026-09-21T00:00:00"
        }
      }
    }
  }
