            {
              "@type": "urpx:EligibilityRule",
              "@id": "pge:er-residential-e-1",
              "urpx:name": "Eligibility for E-1 Residential Service",
              "urpx:description": "Single-phase or polyphase residential service in single-family dwellings, separately metered flats and apartments, common-area accounts in multifamily complexes, and farm service on residential premises. PG&E's default residential schedule for customers not opting into a TOU rate.",
