      "urpx:hasRatePlanVersion": {
        "@type": "urpx:RatePlanVersion",
        "@id": "pge:e-1-2026-03-01",
        "urpx:publishedBy": {
          "@type": "urpx:Organization",
          "@id": "org:utility-pge",
          "urpx:legalName": "Pacific Gas & Electric Company",
          "urpx:organizationType": {
            "@id": "urpx:utilityOrganization"
          }
        },
        "urpx:description": "Default non-TOU residential schedule. Energy is billed at three tiered rates based on percentage of baseline allowance: Tier 1 (0-100%), Tier 2 (101-400%), Tier 2 Continued (over 400%). Generation and Distribution components are tier-agnostic; the tier-varying piece is the Conservation Incentive Adjustment. Customers pay a daily base services charge that varies by income tier (CARE / FERA / standard). KNOWN LIMITATION: the baseline allowance varies by 10 territories × 2 codes (B/H) × 2 seasons; this filing models ONE cell (Territory P, Code B residential, summer 13.5 / winter 11.0 kWh/day). Full-matrix expansion is blocked on upstream URPX-#11 (parameterized matrix-valued tier bounds); tracked under URPXT-cww. Vintage PCIA for CCA/DA/TBS customers is modeled as a sibling RatePlanModifier in this file. (urpx:initialEffectiveDate set to 2001-01-01 as a placeholder for the post-restructuring modern PG&E E-1 era; the schedule predates this.)",
        "urpx:effectiveDateTime": "2026-03-01T00:00:00",
        "urpx:changeReason": {
          "@id": "urpx:rateCase"
        },
        "urpx:priceCurrency": "USD",
