      "urpx:hasCoverageClaim": {
        "@id": "sce:cc-care-2026-03-20",
        "@type": "urpx:CoverageClaim",
        "urpx:completenessResult": {
          "@id": "urpx:partial"
        },
        "urpx:selfContained": true,
        "urpx:explainedBy": {
          "@type": "urpx:Evaluation",
          "@id": "sce:cc-care-2026-03-20-evaluation",
          "urpx:evaluationKind": {
            "@id": "urpx:coverageEvaluation"
          },
          "urpx:description": "Sheet 1 of Schedule D-CARE states a 32.5 percent discount applied to the CARE customer's bill prior to the Public Utilities Commission Reimbursement Fee and any applicable user fees, taxes and late payment charges, and this filing does not represent it. The filing carries only the per-line-item components of the same Sheet 1: the Wildfire Fund Non-Bypassable Charge exemption of $0.00591 per kWh, the Fixed Recovery Charge exemption of $0.00619 per kWh, the Base Services Charge Surcharge exemption of $0.064 per meter per day, and the Base Services Charge Discount of $(0.155) per meter per day. Sheet 1 further exempts CARE customers from the CARE Surcharge of $0.208 per meter per day, which no SCE residential rate sheet in this corpus itemizes, so that exemption has no base charge to cancel and is absent. Two percentage benefits on Sheet 6 are also unrepresented: the San Joaquin Valley Disadvantaged Communities Pilot Bill Protection Discount of Special Condition 14 (20 percent in pilot years 1 through 5, then 10 or 20 percent in years 6 through 10) and the 20 percent Transitional Community Solar Discount of Special Condition 15, each limited to pilot participants. Several other Special Conditions are out of scope rather than missing: the income table in Special Condition 2, the application, commencement, verification and change-of-status rules in Special Conditions 4, 5, 7 and 8, and the Arrearage Management Plan debt forgiveness in Special Condition 13 are eligibility and account-administration procedures, not rates. The California Climate Credit of Special Condition 12 is carried on the base rate plans this modifier overlays.",
          "urpx:evaluatedOn": "2026-09-21T00:00:00"
        }
      }
