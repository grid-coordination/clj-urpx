      "urpx:hasEligibilityRule": [
        {
          "@type": "urpx:EligibilityRule",
          "@id": "sce:care-2026-03-20-er-eligible",
          "urpx:name": "CARE-eligible residential customer",
          "urpx:description": "Customer must be a residential customer enrolled in the CARE program per Schedule D-CARE eligibility requirements. CPUC standard CARE qualifying criteria: household income at-or-below 200% of the Federal Poverty Guidelines, OR enrollment in qualifying public-assistance programs (Medi-Cal, CalFresh, LIHEAP, WIC, SSI, etc.). Application + eligibility declaration required; SCE applies discount no later than one billing period after approval. Customers may be rebilled for periods when they did not meet eligibility requirements. Customers receiving FERA discount are NOT eligible for CARE simultaneously.",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sce:care-2026-03-20-cx-eligible",
            "urpx:rootNode": {
              "@type": "urpx:BooleanOperationNode",
