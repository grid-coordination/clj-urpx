          "@id": "sdge:er-residential-ev-tou",
          "urpx:name": "Eligibility for Schedule EV-TOU-5 — residential customer",
          "urpx:description": "Residential service for households meeting the qualifying-vehicle or NBT condition below. Customer must additionally be a residential customer (urpx:residentialKind).",
          "urpx:hasConditionExpression": {
            "@type": "urpx:ConditionExpression",
            "@id": "sdge:cx-residential-ev-tou",
            "urpx:rootNode": {
              "@type": "urpx:ComparisonNode",
