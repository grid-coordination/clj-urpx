  "@type": "urpx:URPXPackage",
  "@id": "sdge:doc-ev-tou-2026-04-01",
  "urpx:targetURPXVersion": "https://github.com/urpx-org/urpx/raw/v0.5.1/ontology/urpx-ontology.ttl",
  "urpx:hasRatePlan": {
    "@type": "urpx:RatePlan",
    "@id": "sdge:ev-tou",
    "urpx:name": "Schedule EV-TOU Domestic Time-of-Use for Electric Vehicle Charging",
    "urpx:ratePlanUniqueIdentifier": "EV-TOU",
    "urpx:initialEffectiveDate": "2014-01-01",
    "urpx:timezoneIdentifier": "America/Los_Angeles",
    "urpx:hasRatePlanVersion": {
      "@type": "urpx:RatePlanVersion",
      "@id": "sdge:ev-tou-2026-04-01",
      "urpx:description": "SDG&E's older EV-charging-targeted residential TOU schedule (predecessor to EV-TOU-2 and EV-TOU-5; still optionally available per Sheet 1 applicability prose). Per Sheet 1: 'Optionally available to domestic service for charging of a currently registered Motor Vehicle... 1) a battery electric vehicle (BEV) or plug-in hybrid electric vehicle (PHEV) recharged via a recharging outlet at the customer's premises; or, 2) a natural gas vehicle (NGV) refueled via a home refueling appliance (HRA) at the customer's premises.' Pursuant to D.18-01-024, also applicable to customers passing through rates to drivers charging at publicly available EVSE. Customer must SEPARATELY METER the EV charging facilities (Special Condition 2). Same TOU window structure as TOU-DR1/TOU-DR (on-peak 4-9pm every day; super-off-peak weekday split midnight-6am + 10am-2pm, weekend continuous midnight-2pm). Bill structure differs from EV-TOU-5: NO Base Services Charge — uses older $0.413/day Minimum Bill mechanic instead (reduced to $0.207/day for CARE/Medical-Baseline/FERA customers per the 50% discount on Sheet 2 prose). UDC Total has TOU signal: $0.38692/kWh on-peak and off-peak (Distribution component $0.25679); $0.23027/kWh super-off-peak (Distribution $0.10014). UDC sub-components: Transmission $0.10067 (flat), Distribution $0.25679/$0.10014 (TOU-varying), PPP $0.01713, ND $0.00000, CTC -$0.00007, LGC $0.01235, RS $0.00005, TRAC $0.00000. EECC values match EV-TOU-5 exactly: Summer On-Peak $0.47019, Off-Peak $0.17311, Super-Off-Peak $0.08147; Winter On-Peak $0.19990, Off-Peak $0.14337, Super-Off-Peak $0.07410. NO Baseline Adjustment Credit (EV-TOU customers don't receive the baseline credit). 12-month minimum stay rule applies (Special Condition 4) — once enrolled, customer must stay 12 months before changing rate, and once departed, can't return for 1 year. PCIA recovery in bundled EECC rates (Special Condition 9). Optional Billing - Utility Option (Special Condition 6): utility may bill the lower of EV-TOU or non-TOU rate for the first 3 months. CCA-served customers pay UDC + DWR-BC + WF-NBC + their CCA's generation rate plus PCIA. Franchise Fee Differential of 5.78% applies to City of San Diego customers.",
      "urpx:effectiveDateTime": "2026-04-01T00:00:00",
      "urpx:minimumTenure": "P12M",
      "urpx:changeReason": {
        "@id": "urpx:rateCase"
      },
      "urpx:priceCurrency": "USD",
      "urpx:commodity": {
        "@id": "urpx:electricity"
      },
      "urpx:serviceRole": {
        "@id": "urpx:bundledServiceRole"
      },
      "urpx:customerChoice": {
        "@id": "urpx:voluntaryChoice"
      },
      "urpx:isDefault": false,
      "urpx:hasDataSourceReference": {
