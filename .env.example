#
# Settings for the dev scripts. Copy to .env (gitignored), edit, and load into
# the shell with:  set -a; . ./.env; set +a

# A git checkout of https://github.com/urpx-org/urpx. scripts/shacl-drift.sh
# reads the SHACL shapes from it when no checkout path is given.
URPX_DIR=/path/to/urpx

# A python3 that can import rdflib (python3 -m pip install rdflib).
# scripts/shacl-drift.sh runs dev/shacl_extract.py with it. Default: python3.
PYTHON=python3
