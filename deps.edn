{:paths ["src" "resources"]
 :deps {org.clojure/clojure            {:mvn/version "1.12.3"}
        org.clojure/data.json          {:mvn/version "2.5.1"}

        ;; Schema validation and coercion
        metosin/malli                  {:mvn/version "0.20.1"}

        ;; Time
        tick/tick                       {:mvn/version "1.0"}}

 :aliases {:validate {:main-opts ["-m" "urpx.validate"]}

           ;; Dump what the Malli schemas model, for scripts/shacl-drift.sh.
           :drift-facts {:extra-paths ["dev"]
                         :main-opts ["-m" "schema-facts"]}

           ;; SHACL drift report. Prefer scripts/shacl-drift.sh, which feeds it.
           :drift {:extra-paths ["dev"]
                   :main-opts ["-m" "drift"]}

           ;; Dev only. babashka/fs and tools.gitlibs are corpus-walking tools
           ;; for dev/corpus_sweep.clj; the library itself does no filesystem
           ;; traversal and fetches nothing, so neither is a runtime dep.
           ;; Example corpus walkers. Not on the library :paths, never in the
           ;; jar: finding filings is layout-specific, turning them into
           ;; documents is not.
           :corpus {:extra-paths ["corpus"]
                    :extra-deps {babashka/fs {:mvn/version "0.5.22"}}}

           :dev {:extra-paths ["dev"]
                 :extra-deps {babashka/fs {:mvn/version "0.5.22"}
                              org.clojure/tools.gitlibs {:mvn/version "2.5.197"}}}

           :build {:deps {io.github.clojure/tools.build
                          {:git/tag "v0.10.10" :git/sha "deedd62"}
                          slipset/deps-deploy {:mvn/version "0.2.2"}
                          com.dcj/codox-md         {:mvn/version "0.1.0"}
                          com.dcj/build-provenance {:mvn/version "0.2.0"}}
                   :ns-default build}

           :nrepl {:extra-paths ["dev"]
                   :extra-deps {nrepl/nrepl {:mvn/version "1.6.0"}
                                cider/cider-nrepl {:mvn/version "0.50.3"}
                                com.dcj/clj-doc-browse {:mvn/version "0.1.0"}}
                   :jvm-opts ["-Djdk.attach.allowAttachSelf"]
                   :main-opts ["-m" "nrepl.cmdline"
                               "--middleware" "[cider.nrepl/cider-middleware]"]}

           :test {:extra-paths ["test" "test/resources"]
                  :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                  :main-opts ["-m" "kaocha.runner" "--config-file" "tests.edn"]}}}
